---
// The phone menu's footer: the social links. The topics are at the top of the
// menu (TopicNav, via Sidebar.astro).
import SocialIcons from 'virtual:starlight/components/SocialIcons';
---

<div class="mobile-preferences sl-flex">
	<div class="social-icons"><SocialIcons /></div>
</div>

<style>
	.mobile-preferences {
		justify-content: space-between;
		align-items: center;
		border-top: 1px solid var(--border-default);
		padding: 0.75rem 0;
	}
	.social-icons {
		display: flex;
		gap: 1rem;
		align-items: center;
	}
</style>
